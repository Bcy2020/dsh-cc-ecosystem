{
  "hooks": {
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "agent",
            "prompt": "verify: {{UserPromptExpansion}}",
            "timeout": 30,
            "if": "Bash(git *)",
            "statusMessage": "hook running"
          }
        ],
        "matcher": "*"
      }
    ]
  }
}
