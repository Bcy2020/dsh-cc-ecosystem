{
  "hooks": {
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo UserPromptExpansion",
            "timeout": 30,
            "if": "Bash(git *)",
            "statusMessage": "hook running"
          }
        ],
        "matcher": "deploy"
      }
    ]
  }
}
