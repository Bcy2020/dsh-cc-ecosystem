{
  "hooks": {
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "agent",
            "prompt": "verify: {{PermissionDenied}}",
            "timeout": 30,
            "if": "Bash(git *)",
            "statusMessage": "hook running"
          }
        ],
        "matcher": "Bash|Write"
      }
    ]
  }
}
