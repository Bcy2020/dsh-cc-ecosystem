{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "agent",
            "prompt": "verify: {{SessionStart}}",
            "timeout": 30,
            "if": "Bash(git *)",
            "statusMessage": "hook running"
          }
        ],
        "matcher": "*"
      }
    ]
  }
}
