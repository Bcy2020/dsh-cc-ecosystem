{
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "evaluate: {{SubagentStop}}",
            "timeout": 30,
            "if": "Bash(git *)",
            "statusMessage": "hook running"
          }
        ],
        "matcher": "^code-reviewer$"
      }
    ]
  }
}
